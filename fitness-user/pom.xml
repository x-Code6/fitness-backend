<?xml version="1.0" encoding="UTF-8"?>
<!-- 用户服务：注册 / 账号密码登录 / 用户资料；后期在此扩展手机验证码登录 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yuedong</groupId>
        <artifactId>fitness-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>fitness-user</artifactId>
    <name>fitness-user</name>

    <dependencies>
        <!-- Web + 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 注册到 Nacos（lb 负载均衡由网关完成，服务本身不需要 loadbalancer） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- MyBatis-Plus（Boot3 专用 starter，内含 MyBatis 与 Spring 集成） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- BCrypt 密码散列：只引 spring-security 的 crypto 工具包，不引入整个 Security 框架 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- RabbitMQ：消费 notify.# 站内通知事件 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!-- Redis：登录令牌白名单（jti 写入与吊销）。
             架构设计 §2 早就把 Redis 列为 user 服务的依赖，但此前 pom 里并没有引入，
             因为当时 user 服务没有任何地方用 Redis（文档里说的"手机验证码"从未实现）。
             v2 的"禁用用户立即生效"必须有它。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- MongoDB：存"每日身体记录"。
             ★为什么这条数据放 Mongo 而不是 MySQL（面试会被问，答不出来就别加）：
             1) 指标是"可缺省"的——有人只填体重，有人连体脂、围度、睡眠一起填。
                MySQL 要么留一堆 NULL 列，要么每次加指标改表；文档就是"有就写、没有就没这个字段"。
             2) 它的读法永远是"取某个人的一段时间序列"，不做跨人 JOIN，
                关系型的强项（连表、外键、聚合统计）这里一条都用不上。
             3) 它不参与任何业务判定（体脂再高也不会让下单失败），
                所以放在事务与唯一索引之外，代价最低。
             ★反过来，账号、订单、凭证、预约、打卡这些"错了要赔钱"的，一律留在 MySQL。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>
        <dependency>
            <groupId>com.yuedong</groupId>
            <artifactId>fitness-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 自服务的 API 模块：inner 接口签名与 Feign 契约同源 -->
        <dependency>
            <groupId>com.yuedong</groupId>
            <artifactId>fitness-user-api</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
