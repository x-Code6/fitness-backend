# ============================================================
# 换行符统一规则（Windows 上多人/多工具协作必配，否则同一文件会因为
# CRLF/LF 差异产生整文件 diff）
#   text=auto  = 入库统一存 LF，检出时按各人 git 配置处理
# ============================================================
* text=auto

# ---------- 源码与配置：一律文本 ----------
*.java    text
*.xml     text
*.yml     text
*.yaml    text
*.properties text
*.sql     text
*.md      text
*.vue     text
*.js      text
*.json    text
*.html    text
*.css     text

# ---------- 必须是 LF 的（在 Linux/容器里跑，CRLF 会导致脚本无法执行）----------
*.sh      text eol=lf
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
# compose 读的 .env / .env.example：值后面混进一个 \r 是静默故障 ——
# VM_IP=192.168.1.5\r 会原样拼进 Kafka 的广播地址，客户端连不上还看不出原因。
.env      text eol=lf
.env.*    text eol=lf
# nginx 等配置文件要挂进容器，行尾的 \r 会让解析结果不可预期
*.conf    text eol=lf

# ---------- Windows 专用：必须是 CRLF ----------
*.bat   text eol=crlf
*.cmd   text eol=crlf

# ---------- 二进制：禁止任何换行符改写 ----------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.mp4   binary
*.jar   binary
*.bundle binary
