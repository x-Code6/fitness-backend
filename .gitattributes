# ============================================================
# 换行符统一规则（Windows 上多人/多工具协作必配，否则同一文件会因为
# CRLF/LF 差异产生整文件 diff）
#   text=auto  = 入库统一存 LF，检出时按各人 git 配置处理
# ============================================================
* text=auto

# ---------- 源码与配置：一律文本 ----------
*.java    text
*.xml     text
*.yml     text
*.yaml    text
*.properties text
*.sql     text
*.md      text
*.vue     text
*.js      text
*.json    text
*.html    text
*.css     text

# ---------- 必须是 LF 的（在 Linux/容器里跑，CRLF 会导致脚本无法执行）----------
*.sh      text eol=lf
Dockerfile text eol=lf
docker-compose*.yml text eol=lf

# ---------- Windows 专用：必须是 CRLF ----------
*.bat   text eol=crlf
*.cmd   text eol=crlf

# ---------- 二进制：禁止任何换行符改写 ----------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.mp4   binary
*.jar   binary
*.bundle binary
