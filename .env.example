# ============================================================
# 悦动健身 · 后端服务环境变量模板
#
# 用法：cp .env.example .env，再按本机环境改 .env。
#   - .env 已被 .gitignore 排除，任何真实地址与口令都不会入库；
#   - 各服务通过 spring.config.import 读取本文件（见各 application.yml 顶部注释）；
#   - IDEA 里跑单模块时会读 ../.env，在项目根目录跑 fat-jar 时读 ./.env。
#
# 书写规则：一行一个 KEY=VALUE，等号两边不留空格，值不加引号。
# 服务进程与中间件容器各有一份 .env：
#   本文件     → Spring 服务连接中间件时用
#   docker/.env → docker-compose 创建中间件容器时用
# 两边指向同一套中间件时，地址与口令要保持一致。
# ============================================================

# ---------- MySQL（每个业务库在同一实例上，库名写在各服务 yml 里）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=change_me

# ---------- Redis（登录令牌白名单、缓存、排行榜、打卡位图）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 无密码留空即可
REDIS_PASS=

# ---------- RabbitMQ（业务指令类消息：延迟取消、秒杀、通知）----------
MQ_HOST=127.0.0.1
MQ_PORT=5672
MQ_USER=change_me
MQ_PASS=change_me

# ---------- Kafka（行为埋点流）----------
KAFKA_ADDR=127.0.0.1:9092

# ---------- MongoDB（每日身体记录，仅 user 服务使用）----------
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=yd_profile

# ---------- Nacos（注册中心）----------
NACOS_ADDR=127.0.0.1:8848

# ---------- JWT 密钥（两套互不通用，必须与签发方一致）----------
# 用户端：网关与 user 服务用同一个；管理端：admin-server 与 file 服务用同一个。
# 生成方式：openssl rand -base64 48
JWT_SECRET=change_me_at_least_32_bytes_random
ADMIN_JWT_SECRET=change_me_at_least_32_bytes_random
