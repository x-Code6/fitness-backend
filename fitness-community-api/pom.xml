<?xml version="1.0" encoding="UTF-8"?>
<!--
  COMMUNITY 服务 API 模块：对外（服务间）Feign 契约 + 跨服务 DTO。
  消费方按需引入并 @EnableFeignClients(basePackages = "com.yuedong.community.api")；
  fitness-community 自身依赖本模块，保证 provider 与 client 的接口签名/DTO 单一来源。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yuedong</groupId>
        <artifactId>fitness-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>fitness-community-api</artifactId>
    <name>fitness-community-api</name>

    <dependencies>
        <dependency>
            <groupId>com.yuedong</groupId>
            <artifactId>fitness-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
    </dependencies>
</project>
