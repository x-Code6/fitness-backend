<?xml version="1.0" encoding="UTF-8"?>
<!--
  公共模块：被所有业务服务与网关依赖。
  原则：这里只放"跨服务共享的纯逻辑"（统一响应、错误码、异常、JWT 工具、用户上下文），
  不放任何业务逻辑，也不引入 MyBatis/Redis 等重依赖，保证网关(WebFlux)也能安全引用。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yuedong</groupId>
        <artifactId>fitness-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>fitness-common</artifactId>
    <name>fitness-common</name>

    <dependencies>
        <!-- Web 注解（@RestControllerAdvice 等）：只引 spring-web 本体，不带内嵌容器 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- spring-context：BindException/校验异常类在 org.springframework.validation 包里 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!-- 参数校验注解（@NotNull 等），配合服务的 validation starter 使用 -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <!-- 日志门牌：@Slf4j 生成的 log 字段需要它（实现由各服务的 starter 提供） -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Feign 透传拦截器需要（optional：只有引入 OpenFeign 的服务才会装配，见 @ConditionalOnClass） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-openfeign-core</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-core</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 用户上下文拦截器需要（optional：仅在 Servlet Web 业务服务中由
             CommonWebConfig 的 @ConditionalOnWebApplication(SERVLET) 装配；
             网关是 WebFlux 且不扫描 common 包，不受影响） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 幂等防重切面需要（optional：aspectj 的注解与 ProceedingJoinPoint 只在编译期用得到，
             运行期由各服务的 starter 提供——引入 amqp/redis 的服务本来就带 spring-boot-starter-aop；
             网关是 WebFlux 且没有这些依赖，IdempotentConfig 的 @ConditionalOnClass 不会装配它） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 幂等防重与令牌白名单需要 StringRedisTemplate 类型（optional：同理，
             Redis 客户端由各服务自己的 spring-boot-starter-data-redis 提供，
             这样网关不会因为 common 的传递依赖而被拉起一个用不到的连接工厂） -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-redis</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
